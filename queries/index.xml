lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;w&#34;&gt;            &lt;/span&gt;&lt;span class=&#34;s1&#34;&gt;&amp;#39;京东外卖&amp;#39;&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;,&lt;/span&gt;&lt;span class=&#34;w&#34;&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;w&#34;&gt;            &lt;/span&gt;&lt;span class=&#34;s1&#34;&gt;&amp;#39;美团外卖&amp;#39;&lt;/span&gt;&lt;span class=&#34;w&#34;&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;w&#34;&gt;        &lt;/span&gt;&lt;span class=&#34;p&#34;&gt;)&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;k&#34;&gt;THEN&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;s1&#34;&gt;&amp;#39;外卖&amp;#39;&lt;/span&gt;&lt;span class=&#34;w&#34;&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;w&#34;&gt;        &lt;/span&gt;&lt;span class=&#34;k&#34;&gt;ELSE&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;n&#34;&gt;payment_channels&lt;/span&gt;&lt;span class=&#34;w&#34;&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;w&#34;&gt;    &lt;/span&gt;&lt;span class=&#34;k&#34;&gt;END&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;k&#34;&gt;AS&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;err&#34;&gt;渠道&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;,&lt;/span&gt;&lt;span class=&#34;w&#34;&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;w&#34;&gt;    &lt;/span&gt;&lt;span class=&#34;k&#34;&gt;SUM&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;(&lt;/span&gt;&lt;span class=&#34;n&#34;&gt;amount&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;)&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;k&#34;&gt;AS&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;err&#34;&gt;流水&lt;/span&gt;&lt;span class=&#34;w&#34;&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;k&#34;&gt;FROM&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;n&#34;&gt;ads_dbs_trade_shop_pay_channel_di&lt;/span&gt;&lt;span class=&#34;w&#34;&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;k&#34;&gt;WHERE&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;n&#34;&gt;pt&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;k&#34;&gt;LIKE&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;s1&#34;&gt;&amp;#39;202610%&amp;#39;&lt;/span&gt;&lt;span class=&#34;w&#34;&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;w&#34;&gt;    &lt;/span&gt;&lt;span class=&#34;k&#34;&gt;AND&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;n&#34;&gt;shop_id&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;k&#34;&gt;LIKE&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;s1&#34;&gt;&amp;#39;TLL%&amp;#39;&lt;/span&gt;&lt;span class=&#34;w&#34;&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;k&#34;&gt;GROUP&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;k&#34;&gt;BY&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;n&#34;&gt;pt&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;,&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;err&#34;&gt;渠道&lt;/span&gt;&lt;span class=&#34;w&#34;&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;k&#34;&gt;ORDER&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;k&#34;&gt;BY&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;n&#34;&gt;pt&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;,&lt;/span&gt;&lt;span class=&#34;w&#34;&gt; &lt;/span&gt;&lt;span class=&#34;err&#34;&gt;渠道&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;h2 id=&#34;参数调整&#34;&gt;参数调整&lt;a class=&#34;anchor&#34; href=&#34;#%e5%8f%82%e6%95%b0%e8%b0%83%e6%95%b4&#34;&gt;#&lt;/a&gt;&lt;/h2&gt;&#xD;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;&lt;strong&gt;换月份&lt;/strong&gt;：修改 &lt;code&gt;pt LIKE &#39;202610%&#39;&lt;/code&gt; 中的年月部分，如 &lt;code&gt;&#39;202611%&#39;&lt;/code&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;单月精确范围&lt;/strong&gt;：改为 &lt;code&gt;pt &amp;gt;= 20261001 AND pt &amp;lt;= 20261031&lt;/code&gt;（&lt;code&gt;pt&lt;/code&gt; 为整数，不要加引号）&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;含直营店&lt;/strong&gt;：放宽门店过滤为 &lt;code&gt;AND (shop_id LIKE &#39;TLL%&#39; OR shop_id LIKE &#39;ZYD%&#39;)&lt;/code&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h2 id=&#34;注意事项&#34;&gt;注意事项&lt;a class=&#34;anchor&#34; href=&#34;#%e6%b3%a8%e6%84%8f%e4%ba%8b%e9%a1%b9&#34;&gt;#&lt;/a&gt;&lt;/h2&gt;&#xD;&#xA;&lt;style&gt;&#xA;  .notice {&#xA;    --notice-title-color: #fff;&#xA;    --notice-title-bg: #6be;&#xA;    --notice-content-color: #444;&#xA;    --notice-content-bg: #e7f2fa;&#xA;    padding: 0;&#xA;    margin: 1em 0;&#xA;    border-radius: 6px;&#xA;    overflow: hidden;&#xA;    color: var(--notice-content-color);&#xA;    background: var(--notice-content-bg);&#xA;    border: 1px solid var(--notice-title-bg);&#xA;  }&#xA;  .notice.info {&#xA;    --notice-title-bg: #fb7;&#xA;    --notice-content-bg: #fff8e7;&#xA;  }&#xA;  .notice.tip {&#xA;    --notice-title-bg: #5a5;&#xA;    --notice-content-bg: #e8f5e9;&#xA;  }&#xA;  .notice.warning {&#xA;    --notice-title-bg: #c33;&#xA;    --notice-content-bg: #fdecea;&#xA;  }&#xA;  .notice .notice-title {&#xA;    margin: 0;&#xA;    padding: 6px 16px;&#xA;    font-weight: 700;&#xA;    font-size: .9em;&#xA;    color: var(--notice-title-color);&#xA;    background: var(--notice-title-bg);&#xA;    display: flex;&#xA;    align-items: center;&#xA;    gap: 6px;&#xA;  }&#xA;  .notice .notice-title svg {&#xA;    width: 14px;&#xA;    height: 14px;&#xA;    fill: currentColor;&#xA;    flex-shrink: 0;&#xA;  }&#xA;  .notice .notice-body {&#xA;    padding: 12px 16px;&#xA;    line-height: 1.7;&#xA;  }&#xA;  .notice .notice-body &gt; :last-child {&#xA;    margin-bottom: 0;&#xA;  }&#xA;  .notice .notice-body &gt; :first-child {&#xA;    margin-top: 0;&#xA;  }&#xA;&lt;/style&gt;&lt;div class=&#34;notice warning&#34;&gt;&#xA;  &lt;div class=&#34;notice-title&#34;&gt;&lt;svg viewBox=&#34;0 0 24 24&#34;&gt;&lt;path d=&#34;M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z&#34;/&gt;&lt;/svg&gt;注意&lt;/div&gt;&#xA;  &lt;div class=&#34;notice-body&#34;&gt;&lt;ul&gt;&#xA;&lt;li&gt;&lt;code&gt;pt&lt;/code&gt; 为整数类型，&lt;code&gt;LIKE &#39;202610%&#39;&lt;/code&gt; 在 MySQL 中可用（整数会被隐式转字符串），但严谨写法建议用范围条件。&lt;/li&gt;&#xA;&lt;li&gt;渠道分组可能新增 &lt;code&gt;线上新增xx团购&lt;/code&gt; 等原始渠道，运行前检查 &lt;code&gt;ELSE&lt;/code&gt; 分支是否产出未识别渠道；完整映射表见 &lt;a href=&#34;https://tll.jello.top/reference/%E6%B8%A0%E9%81%93%E5%88%86%E7%BB%84/&#34;&gt;渠道分组&lt;/a&gt;。&lt;/li&gt;&#xA;&lt;/ul&gt;&lt;/div&gt;&#xA;&lt;/div&gt;</description>
